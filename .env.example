APP_ROLE=all                     # api | worker | all
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://wagering:wagering@localhost:5432/wagering
DB_POOL_MAX=20
DB_LOCK_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_WAGER_QUEUE=wager-transactions.fifo
SQS_WAGER_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wagering-events.fifo
SQS_MAX_RECEIVE_COUNT=5
SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT_SECONDS=30
SQS_CONSUMER_CONCURRENCY=4
SQS_RETRY_BASE_DELAY_SECONDS=2
SQS_AUTO_CREATE_QUEUES=true
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=100
OUTBOX_LEASE_MS=30000
PENDING_REFERENCE_POLL_INTERVAL_MS=1000
PENDING_REFERENCE_MAX_ATTEMPTS=10
PENDING_REFERENCE_BASE_DELAY_MS=1000
PENDING_REFERENCE_MAX_DELAY_MS=60000
SHUTDOWN_GRACE_MS=20000
# tests
TEST_DATABASE_URL=postgres://wagering:wagering@localhost:5432/wagering_test
TEST_DB_DRIVER=mikro-orm         # or bun-sql
