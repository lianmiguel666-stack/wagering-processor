{
  "name": "wagering-processor",
  "version": "1.0.0",
  "private": true,
  "description": "Distributed wagering processor — Jungle Gaming technical challenge",
  "type": "module",
  "scripts": {
    "start": "bun run src/main.ts",
    "start:api": "APP_ROLE=api bun run src/main.ts",
    "start:worker": "APP_ROLE=worker bun run src/main.ts",
    "migrate:up": "bun run src/infrastructure/persistence/migrate.ts up",
    "migrate:down": "bun run src/infrastructure/persistence/migrate.ts down",
    "migrate:status": "bun run src/infrastructure/persistence/migrate.ts status",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test --timeout 60000",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test --timeout 60000 test/integration",
    "test:concurrency": "bun test --timeout 120000 test/concurrency",
    "test:sqs": "bun test --timeout 120000 test/sqs",
    "send:message": "bun run scripts/send-message.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.700.0",
    "@mikro-orm/core": "^6.4.0",
    "@mikro-orm/migrations": "^6.4.0",
    "@mikro-orm/postgresql": "^6.4.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "prom-client": "^15.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
